# Kernel "anfitrión" para root por LKM con CUALQUIER gestor
# (KernelSU, KernelSU-Next, SukiSU-Ultra...). No integra ningún gestor:
# solo deja el kernel listo para cargar su módulo kernelsu.ko.

# --- Carga de módulos sin firma -------------------------------------------
# Sin firma forzada, el kernel carga módulos externos sin firmar (solo "taint").
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULES=y

# --- Requisitos de los gestores -------------------------------------------
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_EXT4_FS=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# --- Protecciones de Samsung que estorban al root -------------------------
# DEFEX mata los procesos root lanzados desde apps. Es la única activa en
# este árbol (no hay RKP/KDP/UH/FIVE/PROCA/DSMS en este código fuente).
# CONFIG_SECURITY_DEFEX is not set
# CONFIG_SECURITY_DEFEX_USER is not set
# CONFIG_FIVE is not set
# CONFIG_PROCA is not set
# CONFIG_SECURITY_DSMS is not set
